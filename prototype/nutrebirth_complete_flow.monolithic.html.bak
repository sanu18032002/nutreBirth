<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NutReBirth - Ultimate Health Ecosystem</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        :root {
            /* The NutReBirth Premium Palette */
            --bg-base: #030508;
            --bg-surface: #0a0f1a;
            --bg-card: #111827;
            --bg-card-hover: #1f2937;
            --border-color: #1f2937;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
            
            --accent-cyan: #00D4FF;   
            --accent-green: #00FF88;  
            --accent-pink: #FF4081;   
            --accent-yellow: #FFC107; 
            --accent-blue: #2962FF; 
        }

        * { box-sizing: border-box; }

        body {
            background-color: #000;
            background-image: radial-gradient(circle at 50% 0%, #0a1128 0%, #000 70%);
            color: var(--text-main); font-family: 'Montserrat', sans-serif;
            display: flex; justify-content: center; align-items: center;
            height: 100vh; margin: 0; overflow: hidden;
        }

        .mobile-frame {
            width: 100%; max-width: 414px; height: 100%; max-height: 896px;
            background: var(--bg-base); border-radius: 40px; border: 8px solid #222;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.95); position: relative;
            overflow: hidden; display: flex; flex-direction: column;
        }

        @media (max-width: 450px) {
            .mobile-frame { border-radius: 0; border: none; max-width: 100%; max-height: 100%; }
        }

        /* View Router */
        .view {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            display: flex; flex-direction: column; opacity: 0; visibility: hidden;
            transform: translateX(30px); transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
            background: var(--bg-base); z-index: 1; overflow-y: auto; overflow-x: hidden;
            padding-bottom: 90px; /* Space for bottom nav */
        }
        .view.active { opacity: 1; visibility: visible; transform: translateX(0); z-index: 10; }
        .view::-webkit-scrollbar { display: none; }

        /* Shared UI Elements */
        .header {
            padding: 40px 20px 15px; background: rgba(10, 15, 26, 0.9); backdrop-filter: blur(10px);
            display: flex; align-items: center; justify-content: space-between;
            border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 20;
        }
        .header h1 { margin: 0; font-size: 18px; font-weight: 800; }
        .header-left { display: flex; align-items: center; gap: 15px; }
        .back-btn {
            width: 32px; height: 32px; background: #222; border-radius: 50%;
            display: flex; justify-content: center; align-items: center;
            font-weight: bold; cursor: pointer; transition: 0.2s;
        }
        
        .content { padding: 20px; }
        .section-title { font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin: 20px 0 10px; font-weight: 700; }

        .btn-primary {
            width: 100%; background: linear-gradient(90deg, var(--accent-blue), var(--accent-cyan)); color: #fff; 
            padding: 16px; border-radius: 12px; border: none; font-size: 15px; font-weight: 800; 
            cursor: pointer; transition: 0.2s; text-transform: uppercase; letter-spacing: 1px;
            box-shadow: 0 8px 20px rgba(0, 212, 255, 0.2); margin-top: 10px;
        }
        .btn-primary:active { transform: scale(0.98); }
        .btn-secondary {
            background: transparent; border: 1px solid var(--accent-cyan); color: var(--accent-cyan); box-shadow: none;
        }

        .card { background: var(--bg-card); border-radius: 16px; padding: 18px; margin-bottom: 15px; border: 1px solid var(--border-color); }
        
        .input-group { margin-bottom: 15px; }
        .input-label { display: block; font-size: 11px; color: var(--text-muted); font-weight: 700; margin-bottom: 8px; text-transform: uppercase; }
        .styled-input, .styled-select { width: 100%; background: #161b22; border: 1px solid #30363d; padding: 16px; border-radius: 12px; color: #fff; outline: none; font-family: 'Montserrat', sans-serif; font-size:14px; transition:0.3s;}
        .styled-input:focus, .styled-select:focus { border-color: var(--accent-cyan); box-shadow: 0 0 10px rgba(0,212,255,0.1); }
        
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .select-card { background: #161b22; border: 1px solid #30363d; padding: 15px; border-radius: 12px; text-align: center; cursor: pointer; transition: 0.2s; }
        .select-card.active { border-color: var(--accent-cyan); background: rgba(0, 212, 255, 0.1); color: var(--accent-cyan); font-weight: 700;}

        /* Program Cards */
        .program-card { display: flex; align-items: center; gap: 15px; background: var(--bg-card); padding: 16px; border-radius: 16px; border: 1px solid var(--border-color); cursor: pointer; transition: 0.2s; margin-bottom: 12px; }
        .program-card:hover { border-color: var(--accent-cyan); transform: translateY(-2px); }
        .program-icon { width: 50px; height: 50px; border-radius: 12px; display: flex; justify-content: center; align-items: center; font-size: 24px; }
        .program-info h3 { margin: 0 0 4px 0; font-size: 15px; font-weight: 700; }
        .program-info p { margin: 0; font-size: 11px; color: var(--text-muted); line-height: 1.4; }

        /* Bottom Navigation */
        .bottom-nav {
            position: absolute; bottom: 0; left: 0; width: 100%; height: 80px;
            background: rgba(10, 15, 26, 0.95); backdrop-filter: blur(10px);
            display: flex; justify-content: space-around; align-items: center;
            border-top: 1px solid var(--border-color); z-index: 50;
            transform: translateY(100%); transition: transform 0.4s;
        }
        .bottom-nav.visible { transform: translateY(0); }
        .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--text-muted); font-size: 10px; font-weight: 700; cursor: pointer; text-transform: uppercase; }
        .nav-item.active { color: var(--accent-cyan); }
        .nav-item i { font-size: 20px; font-style: normal; }

        /* Chat UI */
        .chat-bubble { max-width: 80%; padding: 12px 16px; border-radius: 16px; margin-bottom: 15px; font-size: 13px; line-height: 1.5; }
        .chat-ai { background: var(--bg-card); border: 1px solid var(--border-color); align-self: flex-start; border-bottom-left-radius: 4px; }
        .chat-user { background: var(--accent-blue); color: #fff; align-self: flex-end; border-bottom-right-radius: 4px; margin-left: auto; }
        .chat-input-area { position: absolute; bottom: 0; width: 100%; padding: 15px; background: var(--bg-base); border-top: 1px solid var(--border-color); display: flex; gap: 10px; align-items: center; }
        .mic-btn { width: 45px; height: 45px; border-radius: 50%; background: var(--accent-cyan); color: #000; display: flex; justify-content: center; align-items: center; font-size: 20px; border: none; cursor: pointer; }

        /* Data Sync Badges */
        .db-badge { font-size: 10px; font-family: monospace; background: rgba(0, 255, 136, 0.1); color: var(--accent-green); padding: 4px 8px; border-radius: 6px; border: 1px solid rgba(0, 255, 136, 0.3); display: inline-block; margin-bottom: 10px;}
    </style>
</head>
<body>

    <div class="mobile-frame">

        <!-- 1. LOGIN -->
        <div id="view-login" class="view active">
            <div class="content" style="display:flex; flex-direction:column; justify-content:center; height:100%; padding-top:40px;">
                <div style="text-align:center; margin-bottom: 40px;">
                    <h1 style="font-size: 32px; font-weight: 900; background: linear-gradient(90deg, #fff, var(--accent-cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">NutReBirth</h1>
                    <p style="color:var(--text-muted); font-size: 13px;">The Ultimate Health Ecosystem</p>
                </div>
                
                <div class="input-group">
                    <span class="input-label">Mobile Number</span>
                    <input type="tel" class="styled-input" placeholder="+91 98765 43210" value="+91 ">
                </div>
                <button class="btn-primary" onclick="navTo('view-questionnaire')">Login via OTP</button>
            </div>
        </div>

        <!-- 2. DEEP QUESTIONNAIRE -->
        <div id="view-questionnaire" class="view">
            <div class="header"><h1>Intake Diagnostics</h1></div>
            <div class="content">
                <p style="font-size: 13px; color: var(--text-muted); line-height:1.5; margin-bottom: 25px;">To calibrate the NutReBirth engines perfectly, we need your comprehensive baseline metrics.</p>
                
                <div class="section-title" style="margin-top: 0;">Core Biometrics</div>
                <div class="grid-2">
                    <div class="input-group">
                        <span class="input-label">Age</span>
                        <input type="number" class="styled-input" placeholder="e.g. 28">
                    </div>
                    <div class="input-group">
                        <span class="input-label">Biological Sex</span>
                        <select class="styled-select">
                            <option>Male</option>
                            <option>Female</option>
                        </select>
                    </div>
                </div>
                <div class="grid-2">
                    <div class="input-group">
                        <span class="input-label">Weight (kg)</span>
                        <input type="number" class="styled-input" placeholder="e.g. 75">
                    </div>
                    <div class="input-group">
                        <span class="input-label">Height (cm)</span>
                        <input type="number" class="styled-input" placeholder="e.g. 175">
                    </div>
                </div>

                <div class="section-title">Lifestyle & Metabolism</div>
                <div class="input-group">
                    <span class="input-label">Daily Activity Level</span>
                    <select class="styled-select">
                        <option>Sedentary (Desk Job)</option>
                        <option>Lightly Active (Some walking)</option>
                        <option>Moderately Active (Workout 3-4x/wk)</option>
                        <option>Highly Active (Athlete / Physical Job)</option>
                    </select>
                </div>
                <div class="input-group">
                    <span class="input-label">Dietary Preference</span>
                    <select class="styled-select" id="q-diet">
                        <option value="omnivore">Omnivore / Standard</option>
                        <option value="vegetarian">Vegetarian</option>
                        <option value="vegan">Vegan</option>
                        <option value="keto">Keto</option>
                    </select>
                </div>

                <div class="section-title">Sleep & Psychological State</div>
                <div class="grid-2">
                    <div class="input-group">
                        <span class="input-label">Avg. Sleep</span>
                        <select class="styled-select">
                            <option>7-9 Hours (Optimal)</option>
                            <option>5-7 Hours</option>
                            <option>&lt; 5 Hours (Deprived)</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <span class="input-label">Stress / Mood</span>
                        <select class="styled-select">
                            <option>Low / Manageable</option>
                            <option>High / Anxious</option>
                            <option>Fatigue / Depressive</option>
                        </select>
                    </div>
                </div>

                <div class="section-title">Physical Readiness</div>
                <div class="input-group">
                    <span class="input-label">Joint Pain / Limitations</span>
                    <div class="grid-2">
                        <div class="select-card" onclick="this.classList.toggle('active')">None / Healthy</div>
                        <div class="select-card" onclick="this.classList.toggle('active')">Lower Back</div>
                        <div class="select-card" onclick="this.classList.toggle('active')">Knees / Hips</div>
                        <div class="select-card" onclick="this.classList.toggle('active')">Shoulders</div>
                    </div>
                </div>

                <div class="section-title">Data Integration</div>
                <div class="input-group">
                    <span class="input-label">Connect Wearable</span>
                    <div class="grid-2">
                        <div class="select-card" onclick="this.classList.toggle('active')">⌚ Apple Watch</div>
                        <div class="select-card" onclick="this.classList.toggle('active')">🟢 Fitbit / Garmin</div>
                    </div>
                </div>

                <button class="btn-primary" style="margin-top: 20px;" onclick="navTo('view-programs')">Analyze Profile &rarr;</button>
            </div>
        </div>

        <!-- 3. PROGRAM SELECTION (5 Tracks) -->
        <div id="view-programs" class="view">
            <div class="header"><h1>Select Program</h1></div>
            <div class="content">
                <p style="font-size: 13px; color: var(--text-muted);">Based on your intake, choose your primary trajectory.</p>

                <!-- Program 1 -->
                <div class="program-card" onclick="selectProgram('maternal')">
                    <div class="program-icon" style="background: rgba(255, 64, 129, 0.1); color: var(--accent-pink);">👶</div>
                    <div class="program-info">
                        <h3>Pre & Post-Natal</h3>
                        <p>Pregnancy safety, folate focus, pelvic floor.</p>
                    </div>
                </div>

                <!-- Program 2 -->
                <div class="program-card" onclick="selectProgram('clinical')">
                    <div class="program-icon" style="background: rgba(255, 193, 7, 0.1); color: var(--accent-yellow);">🩺</div>
                    <div class="program-info">
                        <h3>Chronic Disease Reversal</h3>
                        <p>Diabetes, PCOS, glycemic & endocrine control.</p>
                    </div>
                </div>

                <!-- Program 3 -->
                <div class="program-card" onclick="selectProgram('athletic')">
                    <div class="program-icon" style="background: rgba(0, 212, 255, 0.1); color: var(--accent-cyan);">⚡</div>
                    <div class="program-info">
                        <h3>Athletic Performance</h3>
                        <p>Macro-cycling, power output, CNS tracking.</p>
                    </div>
                </div>

                <!-- Program 4 -->
                <div class="program-card" onclick="selectProgram('rehab')">
                    <div class="program-icon" style="background: rgba(0, 255, 136, 0.1); color: var(--accent-green);">🦴</div>
                    <div class="program-info">
                        <h3>Injury Prevention & Rehab</h3>
                        <p>Correctional exercise, joint health, mobility.</p>
                    </div>
                </div>

                <!-- Program 5 -->
                <div class="program-card" onclick="selectProgram('combat')">
                    <div class="program-icon" style="background: rgba(255, 0, 0, 0.1); color: #ff4444;">🥊</div>
                    <div class="program-info">
                        <h3>Combat Sport Specific</h3>
                        <p>Weight cutting, ballistic power, gas tank prep.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. MEDICAL CLEARANCE (Conditional) -->
        <div id="view-medical" class="view">
            <div class="header"><h1>Medical Clearance</h1></div>
            <div class="content" style="text-align: center;">
                <div style="font-size: 60px; margin: 20px 0;">🏥</div>
                <h2 style="margin-bottom: 10px;">Expert Consultation Required</h2>
                <p style="font-size: 13px; color: var(--text-muted); line-height: 1.5; margin-bottom: 30px;">
                    Because you selected a Clinical or Maternal track, NutReBirth protocols require a brief clearance call with our certified endocrinologist or OB-GYN specialist before generating your nutrition plan.
                </p>
                <div class="card" style="text-align: left;">
                    <div style="font-weight: 700; margin-bottom: 10px;">Available Today</div>
                    <div style="display: flex; gap: 10px;">
                        <div class="select-card" style="flex:1;">1:30 PM</div>
                        <div class="select-card" style="flex:1;">3:00 PM</div>
                        <div class="select-card" style="flex:1;">4:15 PM</div>
                    </div>
                </div>
                <button class="btn-primary" onclick="navTo('view-coach')">Book Medical Consult &rarr;</button>
            </div>
        </div>

        <!-- 5. COACH APPOINTMENT (Accountability) -->
        <div id="view-coach" class="view">
            <div class="header"><h1>Coach Accountability</h1></div>
            <div class="content" style="text-align: center;">
                <div style="font-size: 60px; margin: 20px 0;">🤝</div>
                <h2 style="margin-bottom: 10px;">Meet Your Dedicated Coach</h2>
                <p style="font-size: 13px; color: var(--text-muted); line-height: 1.5; margin-bottom: 30px;">
                    Accountability is the #1 driver of success. Book your kickoff call with your dedicated NutReBirth Coach to finalize your daily macro targets.
                </p>
                
                <div class="card" style="display: flex; align-items: center; gap: 15px; text-align: left; border-color: var(--accent-cyan);">
                    <img src="https://placehold.co/60x60/111827/00D4FF?text=C" style="border-radius: 50%;">
                    <div>
                        <h3 style="margin: 0 0 5px 0;">Coach Arjun</h3>
                        <p style="margin: 0; font-size: 11px; color: var(--accent-green);">Nutrition & Performance Lead</p>
                    </div>
                </div>

                <button class="btn-primary" onclick="finalizeSetup()">Secure Coach & Enter Hub</button>
            </div>
        </div>

        <!-- 6. PROGRAM DELIVERY (THE CORE ENGINE) -->
        <div id="view-hub" class="view">
            <div class="header">
                <div>
                    <h1 style="font-size: 20px;">NutReBirth Hub</h1>
                    <span id="hub-track-title" style="font-size: 10px; color: var(--accent-cyan); text-transform:uppercase; font-weight:700;">Program</span>
                </div>
            </div>
            <div class="content">
                <div class="db-badge">Integrations: Master_Nutrition.xlsx & Exercise_DB.xlsx</div>
                
                <div class="card" style="background: linear-gradient(135deg, #111827, #0a1128); border-color: var(--accent-cyan);">
                    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:15px;">
                        <div>
                            <div style="font-size:10px; color:var(--text-muted); font-weight:700; text-transform:uppercase;">Daily Targets</div>
                            <div style="font-size:24px; font-weight:900; color:var(--accent-cyan);">2,450 <span style="font-size:12px; color:#888;">Kcal</span></div>
                        </div>
                        <div style="text-align:right;">
                            <div style="font-size:12px; font-weight:700;">P: 160g</div>
                            <div style="font-size:12px; font-weight:700;">C: 220g</div>
                            <div style="font-size:12px; font-weight:700;">F: 70g</div>
                        </div>
                    </div>
                </div>

                <div class="section-title">Today's Nutrition Plan</div>
                <div id="engine-meal-plan" style="margin-bottom: 20px;">
                    <!-- Actual Meals Injected by JS -->
                </div>

                <div class="section-title">Today's Workout Plan</div>
                <div id="engine-workout-plan" style="margin-bottom: 20px;">
                    <!-- Actual Exercises Injected by JS -->
                </div>

                <div class="section-title">Applied AI Rules (The "Why")</div>
                <div class="card" id="engine-diet-results" style="font-size: 13px; line-height: 1.5; margin-bottom: 10px;">
                    <!-- Rules Injected by JS -->
                </div>
                <div class="card" id="engine-exercise-results" style="font-size: 13px; line-height: 1.5;">
                    <!-- Rules Injected by JS -->
                </div>
            </div>
        </div>

        <!-- 7. BIOMETRICS & BLOODWORK -->
        <div id="view-biometrics" class="view">
            <div class="header"><h1>Biometrics & Labs</h1></div>
            <div class="content">
                
                <!-- Daily Tracking -->
                <div class="grid-2" style="margin-bottom: 15px;">
                    <div class="card" style="margin:0; text-align:center;">
                        <div style="font-size:24px; margin-bottom:5px;">💧</div>
                        <div style="font-size:18px; font-weight:800;">2.4L</div>
                        <div style="font-size:10px; color:var(--text-muted);">Hydration</div>
                    </div>
                    <div class="card" style="margin:0; text-align:center;">
                        <div style="font-size:24px; margin-bottom:5px;">👣</div>
                        <div style="font-size:18px; font-weight:800;">8,432</div>
                        <div style="font-size:10px; color:var(--text-muted);">Steps</div>
                    </div>
                </div>

                <div class="section-title">Body Composition</div>
                <div class="card">
                    <div style="display:flex; justify-content:space-between; margin-bottom:10px; font-size:13px; font-weight:600;"><span>BMI</span> <span style="color:var(--accent-green);">22.4 (Normal)</span></div>
                    <div style="display:flex; justify-content:space-between; margin-bottom:10px; font-size:13px; font-weight:600;"><span>Body Fat %</span> <span>16.5%</span></div>
                    <div style="display:flex; justify-content:space-between; margin-bottom:10px; font-size:13px; font-weight:600;"><span>Muscle Mass</span> <span>34.2 kg</span></div>
                    <div style="display:flex; justify-content:space-between; font-size:13px; font-weight:600;"><span>Visceral Fat</span> <span style="color:var(--accent-green);">Level 4</span></div>
                </div>

                <div class="section-title">Blood Reports (PDF Parser)</div>
                <div class="card" style="border-color: var(--accent-yellow); background: rgba(255, 193, 7, 0.05);">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                        <span style="font-weight:700; font-size:14px; color:var(--accent-yellow);">🔔 3-Month Alert</span>
                        <span style="font-size:10px; background:#332200; padding:4px 8px; border-radius:4px;">Due Now</span>
                    </div>
                    <p style="font-size:12px; color:var(--text-muted); margin-bottom:15px;">It has been 90 days since your last lipid/HbA1c panel. Please upload a new report.</p>
                    
                    <div style="border: 2px dashed #444; border-radius: 12px; padding: 20px; text-align: center; cursor:pointer;" onclick="alert('Uploads PDF. Backend runs OCR to extract HbA1c, Lipids, etc., into database.')">
                        <div style="font-size:24px; margin-bottom:5px;">📄</div>
                        <div style="font-size:12px; font-weight:700;">Tap to Upload Lab PDF</div>
                    </div>
                </div>
                <button class="btn-primary btn-secondary">Book Blood Test (Phlebotomist)</button>
            </div>
        </div>

        <!-- 8. GROCERY LOGISTICS & MEAL PREP -->
        <div id="view-logistics" class="view">
            <div class="header"><h1>Food Fulfillment</h1></div>
            <div class="content">
                <p style="font-size:12px; color:var(--text-muted);">Your weekly nutrition program has been converted into exact grocery logistics.</p>

                <div class="section-title">Automated Grocery List (Weekly)</div>
                <div class="card">
                    <ul style="list-style:none; padding:0; margin:0; font-size:13px; font-weight:500;">
                        <li style="display:flex; justify-content:space-between; margin-bottom:10px; border-bottom:1px solid #222; padding-bottom:10px;"><span>Chicken Breast (Raw)</span><span style="color:var(--accent-cyan);">2.5 kg</span></li>
                        <li style="display:flex; justify-content:space-between; margin-bottom:10px; border-bottom:1px solid #222; padding-bottom:10px;"><span>Spinach & Greens</span><span style="color:var(--accent-cyan);">800 g</span></li>
                        <li style="display:flex; justify-content:space-between;"><span>Rolled Oats</span><span style="color:var(--accent-cyan);">1.2 kg</span></li>
                    </ul>
                </div>
                
                <div class="grid-2" style="margin-bottom: 20px;">
                    <button class="btn-primary" style="background:#541554; box-shadow:none; font-size:12px;" onclick="alert('Sending list API payload to Zepto...')">Send to Zepto</button>
                    <button class="btn-primary" style="background:#F6D140; color:#000; box-shadow:none; font-size:12px;" onclick="alert('Sending list API payload to Blinkit...')">Send to Blinkit</button>
                </div>

                <div class="section-title">Meal Prep Integration</div>
                <div class="card" style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <div style="font-weight:700; font-size:14px;">Nutri-Kitchen Partners</div>
                        <div style="font-size:11px; color:var(--text-muted);">Want it cooked? We route macros directly to partnered kitchens.</div>
                    </div>
                    <button class="btn-primary btn-secondary" style="width:auto; padding:10px 15px; font-size:12px; margin:0;">Explore</button>
                </div>
            </div>
        </div>

        <!-- 9. CHAT & ACCOUNTABILITY -->
        <div id="view-chat" class="view" style="padding-bottom:150px;">
            <div class="header">
                <div class="header-left">
                    <img src="https://placehold.co/30x30/111827/00D4FF?text=C" style="border-radius: 50%;">
                    <h1>Coach Arjun</h1>
                </div>
                <div style="font-size:20px; cursor:pointer;" onclick="alert('Initiating Video Call via Daily.co/Twilio')">📹</div>
            </div>
            <div class="content" id="chat-box">
                <div style="text-align:center; font-size:10px; color:#555; margin-bottom:20px;">Today, 8:00 AM</div>
                
                <div class="chat-bubble chat-ai">
                    Good morning! Don't forget your hydration goal today. Based on yesterday's workout, your CNS might be a bit fatigued. Let's aim for Zone 2 cardio today.
                </div>
                
                <div class="chat-bubble chat-user">
                    Got it. Just had my breakfast. 3 whole eggs, 2 slices of sourdough toast.
                </div>

                <div class="chat-bubble chat-ai" style="border-color:var(--accent-cyan);">
                    <div style="font-size:10px; color:var(--accent-cyan); font-weight:700; margin-bottom:4px;">🤖 AI MACRO CALCULATION</div>
                    Logged: ~420 kcal (P: 24g, C: 30g, F: 18g). Your coach has been updated.
                </div>
            </div>

            <!-- Voice/Text Input -->
            <div class="chat-input-area">
                <input type="text" class="styled-input" style="margin:0; padding:12px; flex:1;" placeholder="Type or use voice...">
                <button class="mic-btn" onclick="alert('NLP Voice-to-Text activated. Speak your meal/update.')">🎙️</button>
            </div>
        </div>

        <!-- 10. APPOINTMENT PORTAL (General) -->
        <div id="view-portal" class="view">
            <div class="header"><h1>Booking Portal</h1></div>
            <div class="content">
                <div class="section-title" style="margin-top: 0;">Expert Consultations</div>
                <div class="card" style="display:flex; justify-content:space-between; align-items:center; cursor:pointer;">
                    <div><h3 style="margin:0;">Coach Check-in</h3><p style="margin:0; font-size:11px; color:var(--text-muted);">Bi-weekly progress review.</p></div>
                    <div>📅</div>
                </div>
                <div class="card" style="display:flex; justify-content:space-between; align-items:center; cursor:pointer;">
                    <div><h3 style="margin:0;">Physiotherapist</h3><p style="margin:0; font-size:11px; color:var(--text-muted);">Injury & mobility consultation.</p></div>
                    <div>🦴</div>
                </div>
                <div class="card" style="display:flex; justify-content:space-between; align-items:center; cursor:pointer;">
                    <div><h3 style="margin:0;">Phlebotomist (Blood)</h3><p style="margin:0; font-size:11px; color:var(--text-muted);">Home collection booking.</p></div>
                    <div>🩸</div>
                </div>

                <div class="section-title">Account & Settings</div>
                <div class="card" style="display:flex; justify-content:space-between; align-items:center; cursor:pointer;" onclick="navTo('view-plans')">
                    <div><h3 style="margin:0;">Plans & Subscriptions</h3><p style="margin:0; font-size:11px; color:var(--text-muted);">Manage your membership tier.</p></div>
                    <div>💳</div>
                </div>
                <div class="card" style="display:flex; justify-content:space-between; align-items:center; cursor:pointer;" onclick="navTo('view-support')">
                    <div><h3 style="margin:0;">Help & Support</h3><p style="margin:0; font-size:11px; color:var(--text-muted);">FAQs, tutorials, and customer service.</p></div>
                    <div>❓</div>
                </div>
            </div>
        </div>

        <!-- 11. PLANS & SUBSCRIPTIONS -->
        <div id="view-plans" class="view">
            <div class="header">
                <div class="header-left">
                    <div class="back-btn" onclick="navTo('view-portal')">&larr;</div>
                    <h1>Subscriptions</h1>
                </div>
            </div>
            <div class="content">
                <!-- Pricing Toggle -->
                <div class="grid-2" style="margin-bottom: 20px;">
                    <div class="select-card active" onclick="this.parentElement.children[1].classList.remove('active'); this.classList.add('active');">Monthly</div>
                    <div class="select-card" onclick="this.parentElement.children[0].classList.remove('active'); this.classList.add('active');">Annually (-20%)</div>
                </div>
                
                <!-- Plan 1 -->
                <div class="card" style="border-color: var(--border-color);">
                    <h3 style="margin:0 0 5px 0;">NutReBirth Essential</h3>
                    <div style="font-size:28px; font-weight:900; color:#fff; margin-bottom:15px;">₹1,999<span style="font-size:12px; font-weight:500; color:var(--text-muted);"> /mo</span></div>
                    <ul style="font-size:12px; color:var(--text-muted); line-height:1.8; padding-left:15px; margin:0 0 20px 0;">
                        <li>AI Diet & Exercise Data Engines</li>
                        <li>Automated Grocery List Generation</li>
                        <li>Basic Biometrics & Wearable Sync</li>
                        <li>Standard Community Support</li>
                    </ul>
                    <button class="btn-primary btn-secondary" style="padding:12px; margin:0;">Current Plan</button>
                </div>
                
                <!-- Plan 2 -->
                <div class="card" style="border-color: var(--accent-cyan); background: linear-gradient(145deg, #111827, #0a1128);">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:5px;">
                        <h3 style="margin:0;">NutReBirth Elite</h3>
                        <span style="background:var(--accent-cyan); color:#000; font-size:9px; font-weight:800; padding:3px 8px; border-radius:12px; text-transform:uppercase;">Most Popular</span>
                    </div>
                    <div style="font-size:28px; font-weight:900; color:var(--accent-cyan); margin-bottom:15px;">₹4,999<span style="font-size:12px; font-weight:500; color:var(--text-muted);"> /mo</span></div>
                    <ul style="font-size:12px; color:var(--text-muted); line-height:1.8; padding-left:15px; margin:0 0 20px 0;">
                        <li style="color:#fff;"><strong>Everything in Essential, plus:</strong></li>
                        <li>Dedicated 1-on-1 Human Coach</li>
                        <li>Medical/Endocrinologist Consultations</li>
                        <li>AI Form Correction Camera Access</li>
                        <li>Cloud Kitchen Direct Logistics</li>
                    </ul>
                    <button class="btn-primary" style="padding:12px; margin:0; box-shadow: 0 4px 15px rgba(0, 212, 255, 0.2);">Upgrade to Elite</button>
                </div>
            </div>
        </div>

        <!-- 12. HELP & SUPPORT -->
        <div id="view-support" class="view">
            <div class="header">
                <div class="header-left">
                    <div class="back-btn" onclick="navTo('view-portal')">&larr;</div>
                    <h1>Help & Support</h1>
                </div>
            </div>
            <div class="content">
                <div class="input-group">
                    <input type="text" class="styled-input" placeholder="Search for help... (e.g., Apple Watch)">
                </div>

                <div class="section-title">Quick Actions</div>
                <div class="card" style="display:flex; justify-content:space-between; align-items:center; cursor:pointer;" onclick="alert('Connecting to Live Agent...')">
                    <div><h3 style="margin:0;">Live Chat Support</h3><p style="margin:0; font-size:11px; color:var(--text-muted);">Avg wait time: ~2 mins.</p></div>
                    <div style="font-size:20px;">💬</div>
                </div>
                <div class="card" style="display:flex; justify-content:space-between; align-items:center; cursor:pointer;">
                    <div><h3 style="margin:0;">Video Tutorials</h3><p style="margin:0; font-size:11px; color:var(--text-muted);">Master the NutReBirth ecosystem.</p></div>
                    <div style="font-size:20px;">📺</div>
                </div>

                <div class="section-title">Frequently Asked Questions</div>
                <div class="card" style="margin-bottom:10px;">
                    <div style="font-size:13px; font-weight:700; margin-bottom:5px;">How do I sync my smart watch?</div>
                    <div style="font-size:11px; color:var(--text-muted); line-height:1.5;">Navigate to the Biometrics tab, click the 'Live Sync' status indicator, and authenticate with Apple Health or Google Fit to automatically import your steps, HRV, and sleep.</div>
                </div>
                <div class="card" style="margin-bottom:10px;">
                    <div style="font-size:13px; font-weight:700; margin-bottom:5px;">Can I switch my medical track?</div>
                    <div style="font-size:11px; color:var(--text-muted); line-height:1.5;">Yes. If your goal changes (e.g., from Athletic to Prenatal), reach out to your coach or retake the Triage Diagnostic to safely recalibrate your diet and exercise engines.</div>
                </div>
                <div class="card" style="margin-bottom:10px;">
                    <div style="font-size:13px; font-weight:700; margin-bottom:5px;">How does the grocery logistics work?</div>
                    <div style="font-size:11px; color:var(--text-muted); line-height:1.5;">The engine calculates your exact weekly macros, converts them to physical food quantities, and generates an automated cart link for Blinkit or Zepto.</div>
                </div>
            </div>
        </div>

        <!-- BOTTOM NAVIGATION -->
        <div class="bottom-nav" id="main-nav">
            <div class="nav-item active" onclick="navTo('view-hub', this)"><i>🏠</i>Hub</div>
            <div class="nav-item" onclick="navTo('view-biometrics', this)"><i>❤️</i>Bio</div>
            <div class="nav-item" onclick="navTo('view-logistics', this)"><i>📦</i>Diet</div>
            <div class="nav-item" onclick="navTo('view-portal', this)"><i>📅</i>Book</div>
            <div class="nav-item" onclick="navTo('view-chat', this)"><i>💬</i>Chat</div>
        </div>

    </div>

    <script>
        // State
        let activeProgram = "";
        
        // Navigation Logic
        function navTo(viewId, navElement = null) {
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            document.getElementById(viewId).classList.add('active');

            // Bottom Nav Visibility
            const inAppScreens = ['view-hub', 'view-biometrics', 'view-logistics', 'view-portal', 'view-chat', 'view-plans', 'view-support'];
            const nav = document.getElementById('main-nav');
            if(inAppScreens.includes(viewId)) {
                nav.classList.add('visible');
            } else {
                nav.classList.remove('visible');
            }

            // Update Active Nav Style
            if(navElement) {
                document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
                navElement.classList.add('active');
            }
        }

        // Sequential Flow Logic
        function selectProgram(trackId) {
            activeProgram = trackId;
            
            // Medical Clearance Gate
            if(trackId === 'clinical' || trackId === 'maternal') {
                navTo('view-medical');
            } else {
                // Skip to Coach
                navTo('view-coach');
            }
        }

        function finalizeSetup() {
            // Generate the dynamic data based on Excel Logic Simulation
            generateProgramLogic(activeProgram);
            
            // Update Title
            const titles = {
                'clinical': 'Chronic Disease Protocol',
                'maternal': 'Pre/Post-Natal Protocol',
                'athletic': 'Peak Athlete Protocol',
                'rehab': 'Correctional Rehab Protocol',
                'combat': 'Combat Sports Protocol'
            };
            document.getElementById('hub-track-title').innerText = titles[activeProgram];
            
            navTo('view-hub', document.querySelectorAll('.nav-item')[0]);
        }

        // ==========================================
        // DATA ENGINE: Simulating the Excel Integration
        // ==========================================
        const NutReBirthDataEngine = {
            nutritionRules: {
                clinical: [
                    { type: 'EXCLUDE', text: 'High Glycemic Foods (ICMR/FDA Ref: Glucose Spike)', color: 'var(--accent-pink)' },
                    { type: 'REQUIRE', text: 'High Fiber > 35g/day (Insulin Sensitivity)', color: 'var(--accent-cyan)' }
                ],
                maternal: [
                    { type: 'EXCLUDE', text: 'Raw Seafood / High Mercury (FDA Ref)', color: 'var(--accent-pink)' },
                    { type: 'REQUIRE', text: 'High Folate & Calcium Density', color: 'var(--accent-green)' }
                ],
                athletic: [
                    { type: 'REQUIRE', text: 'Targeted Carbohydrate Cycling (Pre/Intra)', color: 'var(--accent-blue)' },
                    { type: 'LIMIT', text: 'Fat intake near training windows', color: 'var(--accent-yellow)' }
                ]
            },
            exerciseRules: {
                clinical: [
                    { type: 'APPROVED', text: 'Zone 2 LISS (Mitochondrial function)', color: 'var(--accent-green)' },
                    { type: 'VETOED', text: 'Extreme HIIT (Cortisol/Insulin disruption)', color: 'var(--accent-pink)' }
                ],
                maternal: [
                    { type: 'APPROVED', text: 'Seated / Supported Compound Lifts', color: 'var(--accent-green)' },
                    { type: 'VETOED', text: 'Supine (Back-laying) exercises after T1', color: 'var(--accent-pink)' },
                    { type: 'VETOED', text: 'Heavy Valsalva Maneuver (Core Brace)', color: 'var(--accent-pink)' }
                ],
                athletic: [
                    { type: 'PRIORITY', text: 'Ballistic / Plyometric Power Modules', color: 'var(--accent-cyan)' },
                    { type: 'MODIFIED', text: 'Auto-regulated Volume based on CNS HRV', color: 'var(--accent-yellow)' }
                ]
            },
            // THE ACTUAL GENERATED PLANS FROM THE MASTER EXCEL SHEETS
            mealPlans: {
                clinical: [
                    { meal: "Breakfast", food: "Moong Dal Chilla with Mint Chutney", qty: "60g Moong Dal (raw/dry weight), 30g Chutney", macros: "P: 22g | C: 35g (Low GI) | F: 8g" },
                    { meal: "Lunch", food: "Grilled Chicken & Quinoa Salad", qty: "150g Chicken (raw), 50g Quinoa (dry), 10ml Olive Oil", macros: "P: 45g | C: 40g | F: 15g" },
                    { meal: "Dinner", food: "Baked Salmon with Steamed Broccoli", qty: "120g Salmon (raw), 150g Broccoli", macros: "P: 40g | C: 15g | F: 22g" }
                ],
                maternal: [
                    { meal: "Breakfast", food: "Spinach & Feta Omelette (Folate/Calcium)", qty: "3 Whole Eggs, 50g Spinach, 30g Feta Cheese", macros: "P: 25g | C: 10g | F: 18g" },
                    { meal: "Lunch", food: "Lentil Soup & Roasted Sweet Potato (Iron)", qty: "200ml Lentil Soup (thick), 150g Sweet Potato (raw)", macros: "P: 20g | C: 55g | F: 12g" },
                    { meal: "Dinner", food: "Pasteurized Greek Yogurt Parfait", qty: "200g Greek Yogurt, 50g Mixed Berries", macros: "P: 20g | C: 30g | F: 5g" }
                ],
                athletic: [
                    { meal: "Pre-Workout", food: "Rice Cakes, Honey & Whey Isolate", qty: "3x Rice Cakes, 15g Honey, 1 Scoop (30g) Whey", macros: "P: 30g | C: 50g | F: 2g" },
                    { meal: "Post-Workout", food: "Chicken Breast & Jasmine White Rice", qty: "200g Chicken (raw), 100g Rice (dry)", macros: "P: 55g | C: 80g | F: 5g" },
                    { meal: "Dinner", food: "Lean Beef Steak & Sweet Potato Wedges", qty: "180g Lean Beef (raw), 200g Sweet Potato", macros: "P: 50g | C: 60g | F: 15g" }
                ]
            },
            workoutPlans: {
                clinical: [
                    { name: "Post-Meal Brisk Walk", sets: "15 Mins", notes: "Glucose clearing mechanism." },
                    { name: "Resistance Band Squats", sets: "3 Sets x 12 Reps", notes: "Build muscle insulin sensitivity." },
                    { name: "Incline Planks", sets: "3 Sets x 30 Secs", notes: "Core stability without high pressure." }
                ],
                maternal: [
                    { name: "Seated Cable Rows", sets: "3 Sets x 12 Reps", notes: "Strengthens posture for belly load." },
                    { name: "Bird-Dog Extensions", sets: "3 Sets x 10/side", notes: "Safe core stability." },
                    { name: "Incline Push-ups", sets: "3 Sets x 10 Reps", notes: "Alleviates intra-abdominal pressure." }
                ],
                athletic: [
                    { name: "Barbell Power Cleans", sets: "5 Sets x 3 Reps", notes: "Focus on peak concentric velocity." },
                    { name: "Trap Bar Deadlifts", sets: "4 Sets x 5 Reps", notes: "Heavy load, minimize spinal shear." },
                    { name: "Med Ball Rotational Throws", sets: "3 Sets x 8/side", notes: "Translational punching power." }
                ]
            }
        };

        function generateProgramLogic(track) {
            // Default to athletic if rehab/combat selected for this demo
            const mappedTrack = ['clinical', 'maternal'].includes(track) ? track : 'athletic';
            
            const nRules = NutReBirthDataEngine.nutritionRules[mappedTrack];
            const eRules = NutReBirthDataEngine.exerciseRules[mappedTrack];
            const meals = NutReBirthDataEngine.mealPlans[mappedTrack];
            const workouts = NutReBirthDataEngine.workoutPlans[mappedTrack];

            // Render Meals (Updated with Quantities)
            let mealsHtml = '';
            meals.forEach(m => {
                mealsHtml += `
                <div class="card" style="padding: 12px; margin-bottom: 8px;">
                    <div style="font-size: 10px; color: var(--accent-cyan); font-weight: 800; text-transform: uppercase;">${m.meal}</div>
                    <div style="font-size: 14px; font-weight: 700; margin: 4px 0;">${m.food}</div>
                    <div style="font-size: 11px; color: var(--accent-green); font-weight: 600; margin-bottom: 6px;">⚖️ ${m.qty}</div>
                    <div style="font-size: 11px; color: var(--text-muted);">${m.macros}</div>
                </div>`;
            });
            document.getElementById('engine-meal-plan').innerHTML = mealsHtml;

            // Render Workouts
            let workoutsHtml = '';
            workouts.forEach(w => {
                workoutsHtml += `
                <div class="card" style="padding: 12px; margin-bottom: 8px; border-left: 3px solid var(--accent-green);">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div style="font-size: 14px; font-weight: 700;">${w.name}</div>
                        <div style="font-size: 11px; background: rgba(0, 255, 136, 0.1); color: var(--accent-green); padding: 2px 6px; border-radius: 4px; font-weight: 700;">${w.sets}</div>
                    </div>
                    <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">${w.notes}</div>
                </div>`;
            });
            document.getElementById('engine-workout-plan').innerHTML = workoutsHtml;

            // Render Rules
            let nHtml = '';
            nRules.forEach(item => {
                nHtml += `<div style="display:flex; gap:10px; margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #222;">
                            <span style="font-size:9px; font-weight:800; padding:2px 6px; border-radius:4px; border:1px solid ${item.color}; color:${item.color}; height:fit-content;">${item.type}</span>
                            <span>${item.text}</span>
                          </div>`;
            });
            document.getElementById('engine-diet-results').innerHTML = nHtml;

            let eHtml = '';
            eRules.forEach(item => {
                eHtml += `<div style="display:flex; gap:10px; margin-bottom:10px; padding-bottom:10px; border-bottom:1px solid #222;">
                            <span style="font-size:9px; font-weight:800; padding:2px 6px; border-radius:4px; border:1px solid ${item.color}; color:${item.color}; height:fit-content;">${item.type}</span>
                            <span>${item.text}</span>
                          </div>`;
            });
            document.getElementById('engine-exercise-results').innerHTML = eHtml;
        }

    </script>
</body>
</html>